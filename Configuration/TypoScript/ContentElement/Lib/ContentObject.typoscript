## Set default for lib. used in various templates
# 10 as empty TEXT
# 20 is actual FLUIDTEMPLATE, and if 20 isn't set an exception will be thrown in fCobject
lib.contentObject = COA
lib.contentObject {
  empty = COA
  empty {
    10 = TEXT
  }
  headerMiddleSearch =< lib.contentObject.empty
  headerTopSearch =< lib.contentObject.empty
  mainNavigationSearch =< lib.contentObject.empty
}
